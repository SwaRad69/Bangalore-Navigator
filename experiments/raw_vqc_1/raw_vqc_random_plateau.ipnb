      "source": [
        "import json, os\n",
        "\n",
        "RESULTS_DIR = f\"/content/results/raw_vqc/{DATASET_NAME}\"\n",
        "os.makedirs(RESULTS_DIR, exist_ok=True)\n",
        "\n",
        "with open(f\"{RESULTS_DIR}/results.json\", \"w\") as f:\n",
        "    json.dump(depth_vs_var, f, indent=4)\n",
        "\n",
        "print(\"Results saved to:\", RESULTS_DIR)\n"
      ]
    },
